{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "google/apiclient": "2.15",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^9.19",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.7",
        "maatwebsite/excel": "3.1.47",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test:setup": [
            "@php artisan db:create-test-database"
        ],
        "test": [
            "@php artisan test"
        ],
        "test:security": [
            "@php artisan test --testsuite=Security"
        ],
        "lint": [
            "pint --test"
        ],
        "lint:fix": [
            "pint"
        ],
        "lint:changed": [
            "pint --test --dirty"
        ],
        "ci": [
            "@lint:changed",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test:setup": "Create the dedicated test database (safe: refuses non-test names)",
        "test": "Run the full test suite against the isolated test database",
        "test:security": "Run only the security regression suite",
        "lint": "Report Laravel Pint style issues across the whole codebase (legacy baseline is large)",
        "lint:fix": "Apply Pint formatting",
        "lint:changed": "Check Pint style on changed files only - this is what CI enforces",
        "ci": "Run the checks CI runs"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
