# =============================================================================
# TESTING ENVIRONMENT — copy to `.env.testing` and fill in local credentials.
# =============================================================================
#
# WHY THIS FILE EXISTS
#
# `php artisan <command> --env=testing` loads `.env.testing`. When that file is
# ABSENT, Laravel silently falls back to `.env` — it sets APP_ENV=testing but
# keeps the DEVELOPMENT database credentials. On 2026-08-24 that fallback caused
# `migrate:fresh --env=testing` to drop every table in the local `dentalLink`
# database. `phpunit.xml` did not help: its <env> block is read by PHPUnit only,
# never by artisan.
#
# So: this file is not a convenience. Its absence is the bug.
#
# DB_DATABASE must end in `_test` or `_testing`. The destructive-command guard
# in App\Support\DatabaseSafety refuses to run migrate:fresh / migrate:refresh /
# db:wipe against anything else, and fails closed when the name is ambiguous.

APP_NAME=DentHub
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The guard requires this name to end in `_test` or `_testing`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=denthub_testing
DB_USERNAME=root
DB_PASSWORD=

# Keep every side effect in-memory so a test run cannot touch real
# queues, caches, mailboxes or notification providers.
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Cheapest hash that still exercises the real driver.
BCRYPT_ROUNDS=4
